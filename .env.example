# GoreeCloud Notes development configuration
# Copy to .env and keep .env out of source control.

TZ=America/Chicago
API_PORT=8000
APP_SECRET_GID=20001

POSTGRES_DB=goreecloud_notes
POSTGRES_USER=goreecloud_notes
POSTGRES_PASSWORD_SOURCE=./secrets/postgres_password

GOREECLOUD_NOTES_ENVIRONMENT=development
GOREECLOUD_NOTES_API_PREFIX=/api/v1
GOREECLOUD_NOTES_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
GOREECLOUD_NOTES_SESSION_TTL_SECONDS=43200
GOREECLOUD_NOTES_REVISION_MIN_INTERVAL_SECONDS=300
GOREECLOUD_NOTES_ATTACHMENT_ROOT=/var/lib/goreecloud-notes/attachments
GOREECLOUD_NOTES_ATTACHMENT_MAX_BYTES=52428800
# Development/test may use 0 to disable the owner-level total storage quota.
# Production must set an explicit positive value at least as large as
# GOREECLOUD_NOTES_ATTACHMENT_MAX_BYTES after storage capacity is approved.
GOREECLOUD_NOTES_ATTACHMENT_USER_QUOTA_BYTES=0

# Bounded login-abuse controls. These development defaults are intentionally
# temporary cooldowns, not permanent account lockouts.
GOREECLOUD_NOTES_LOGIN_RATE_WINDOW_SECONDS=300
GOREECLOUD_NOTES_LOGIN_RATE_ACCOUNT_FAILURES=5
GOREECLOUD_NOTES_LOGIN_RATE_SOURCE_FAILURES=20
GOREECLOUD_NOTES_LOGIN_RATE_COOLDOWN_SECONDS=300
GOREECLOUD_NOTES_LOGIN_RATE_STATE_TTL_SECONDS=86400
# Leave empty until the exact production Caddy/private-proxy source CIDRs are
# verified. X-Forwarded-For is ignored unless the direct peer is trusted here.
GOREECLOUD_NOTES_TRUSTED_PROXY_CIDRS=

GOREECLOUD_NOTES_DATABASE_HOST=db
GOREECLOUD_NOTES_DATABASE_PORT=5432
GOREECLOUD_NOTES_DATABASE_NAME=goreecloud_notes
GOREECLOUD_NOTES_DATABASE_USER=goreecloud_notes
GOREECLOUD_NOTES_DATABASE_PASSWORD_FILE=/run/secrets/postgres_password
